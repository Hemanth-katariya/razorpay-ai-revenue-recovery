# Copy to .env and fill in before running the app.

# Required for the Diagnosis Service (app/ai/diagnosis.py).
# Switched from Claude to Gemini for cost reasons -- see
# docs/implementation-notes.md. Get a free key at aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Required only once the §4.1 capability spike is run and an action is
# promoted to API_VERIFIED (docs/product-spec.md §4.1). Test Mode keys only --
# never live/production keys, per CLAUDE.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Used to sign/verify synthetic webhook replays (app/api/webhooks.py).
# Change this from the default before any non-local use.
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Policy gate defaults (docs/product-spec.md §5) -- optional overrides.
MAX_ATTEMPTS=3
COOLDOWN_HOURS=24
PER_SUB_EXPOSURE_CAP=10000000
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.6

DATABASE_URL=sqlite:///./recoverflow.db
